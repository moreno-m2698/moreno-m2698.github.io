{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12"
  },
  "scripts": {
    "postinstall": "nuxt prepare",
    "dev": "PORTFOLIO_FIXTURES=1 nuxt dev",
    "generate": "nuxt generate",
    "build": "pnpm generate",
    "typecheck": "nuxt typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "validate:html": "html-validate \"content/articles/**/*.html\" \"tests/fixtures/articles/**/*.html\" && node scripts/check-article-rules.mjs"
  },
  "dependencies": {
    "nuxt": "^4.6.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "html-validate": "^11.16.4",
    "node-html-parser": "^9.0.5",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.13"
  }
}
